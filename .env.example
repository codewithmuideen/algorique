# Server-side only. Never prefix these with VITE_ and never commit a real .env file.
# Set them in Vercel: Project > Settings > Environment Variables.

# API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Inbox that receives booking requests and enquiries (comma separated for several)
BUSINESS_EMAIL=bookings@your-domain.co.uk

# Sender on a domain verified in Resend, e.g. website@your-domain.co.uk
VERIFIED_FROM_EMAIL=website@your-domain.co.uk

# Public URL of the live site, shown in notification emails
PUBLIC_SITE_URL=https://www.your-domain.co.uk
